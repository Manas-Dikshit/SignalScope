DATABASE_URL=postgresql+asyncpg://signalscope:signalscope@postgres:5432/signalscope
DATABASE_URL_SYNC=postgresql://signalscope:signalscope@postgres:5432/signalscope
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
MAX_UPLOAD_BYTES=209715200
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Optional local Gemma 4 sidecar
AI_ENABLED=false
AI_SERVICE_URL=http://ai:8100
AI_MODEL=google/gemma-4-E4B-it
AI_BACKEND=fake
AI_TIMEOUT_SECONDS=120
AI_PROMPT_VERSION=2026-11-01
# Shared secret for the private AI -> DSP tool route. Empty disables the route.
INTERNAL_API_TOKEN=change-me
API_INTERNAL_URL=http://api:8000
AI_TOOL_TIMEOUT_SECONDS=30
AI_EVIDENCE_IMAGES_ENABLED=true
AI_MAX_IMAGE_BYTES=300000
AI_MAX_TOTAL_IMAGE_BYTES=1000000
AI_MAX_TOOL_STEPS=6
